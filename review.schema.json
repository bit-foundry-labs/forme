{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forme Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "summary",
    "findings",
    "verification"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "observation",
          "impact",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "string",
      "minLength": 1
    }
  }
}
